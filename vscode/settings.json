{
  /* -------------------------------------------------------------------------- */
  /*                              APPEARANCE AND UI                             */
  /* -------------------------------------------------------------------------- */

  /* ----------------------------- GENERAL LAYOUT ----------------------------- */

  "workbench.iconTheme": null,
  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "bottom",
  "workbench.statusBar.visible": true,
  "workbench.startupEditor": "none",
  "workbench.editor.showTabs": "single",
  "workbench.editor.editorActionsLocation": "hidden",
  "zenMode.hideLineNumbers": false,

  /* -------------------------------- WINDOW ---------------------------------- */

  "window.newWindowProfile": "Default",

  /* ----------------------------- FILE EXPLORER ------------------------------ */

  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  /* ---------------------------- FONT AND THEMING ---------------------------- */

  "workbench.colorTheme": "Apprentice",
  "editor.fontFamily": "ComicShannsMono Nerd Font Mono",
  "editor.fontSize": 18,
  "editor.fontLigatures": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "entity.name.type.class",
          "constant",
          "storage.modifier",
          "storage.type.class.js",
          "keyword"
        ],
        "settings": {
          "fontStyle": "italic bold"
        }
      }
    ]
  },

  /* -------------------------------------------------------------------------- */
  /*                              EDITOR BEHAVIOUR                              */
  /* -------------------------------------------------------------------------- */

  /* -------------------------- CURSOR AND SCROLLING -------------------------- */

  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 8,

  /* -------------------- CODE INTELLIGENCE AND ASSISTANCE -------------------- */

  "editor.inlayHints.enabled": "on",
  "editor.inlineSuggest.enabled": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "workbench.tree.enableStickyScroll": true,
  "editor.acceptSuggestionOnEnter": "on",

  /* ---------------------- VISUAL GUIDES AND WHITESPACE ---------------------- */

  "editor.lineNumbers": "relative",
  "editor.renderWhitespace": "all",
  "editor.minimap.enabled": false,
  "editor.glyphMargin": false,
  "editor.rulers": [80, 100],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,

  /* -------------------------------------------------------------------------- */
  /*                        FORMATTING AND FILE HANDLING                        */
  /* -------------------------------------------------------------------------- */

  "files.autoSave": "onFocusChange",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.wordWrap": "off",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.wordWrap": "off",
  "editor.codeActionsOnSave": {
    "source.sortImports": "always"
  },

  /* -------------------------------------------------------------------------- */
  /*                                  TERMINAL                                  */
  /* -------------------------------------------------------------------------- */

  "terminal.integrated.fontSize": 18,
  "terminal.integrated.defaultProfile.windows": "archlinux (WSL)",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.enablePersistentSessions": false,

  /* -------------------------------------------------------------------------- */
  /*                           EXTENSION CONFIGURATION                          */
  /* -------------------------------------------------------------------------- */

  /* ----------------------------------- VIM ---------------------------------- */

  "vim.useSystemClipboard": true,
  "vim.leader": "<space>",
  "vim.startInInsertMode": true,
  "vim.hlsearch": true,
  "vim.showcmd": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "#6C6C6C",
  "vim.highlightedyank.textColor": "#FFFFFF",
  "vim.useCtrlKeys": true,
  "vim.handleKeys": {
    "<C-r>": false, // workbench.action.togglePanel
    "<C-s>": false // workbench.action.showCommands
  },

  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["n"], "after": ["h"] }, // Left
    { "before": ["e"], "after": ["j"] }, // Down
    { "before": ["i"], "after": ["k"] }, // Up
    { "before": ["o"], "after": ["l"] }, // Right

    { "before": ["l"], "after": ["i"] }, // Insert
    { "before": ["h"], "after": ["o"] }, // Open line below
    { "before": ["j"], "after": ["e"] }, // End of word
    { "before": ["k"], "after": ["n"] }, // Next match

    { "before": ["N"], "after": ["H"] }, // Top of screen
    { "before": ["E"], "after": ["J"] }, // Join lines
    { "before": ["I"], "commands": ["editor.action.showHover"] }, // K, via command
    { "before": ["O"], "after": ["L"] }, // Bottom of screen

    { "before": ["L"], "after": ["I"] }, // Insert at first non-blank
    { "before": ["H"], "after": ["O"] }, // Open line above
    { "before": ["J"], "after": ["E"] }, // End of WORD
    { "before": ["K"], "after": ["N"] }, // Previous match

    // Redo. <C-r> now belongs to VSCode (see vim.handleKeys above), and U
    // is free because the permutation never claims it
    { "before": ["U"], "after": ["<C-r>"] },

    {
      "before": ["<leader>", "b"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },

    // Splits
    {
      "before": ["<leader>", "s", "v"],
      "commands": ["workbench.action.newGroupRight"]
    },
    {
      "before": ["<leader>", "s", "h"],
      "commands": ["workbench.action.newGroupBelow"]
    },
    {
      "before": ["<leader>", "s", "e"],
      "commands": ["workbench.action.evenEditorWidths"]
    },

    // Coding
    {
      "before": ["<leader>", "c", "c"],
      "commands": ["editor.action.commentLine"]
    },
    { "before": ["<leader>", "c", "r"], "commands": ["editor.action.rename"] },
    {
      "before": ["<leader>", "c", "a", "s"],
      "commands": ["workbench.action.showAllSymbols"]
    },
    {
      "before": ["<leader>", "c", "s"],
      "commands": ["workbench.action.gotoSymbol"]
    },

    // Go to
    {
      "before": ["<leader>", "g", "d"],
      "commands": ["editor.action.revealDefinition"]
    },
    {
      "before": ["<leader>", "g", "r"],
      "commands": ["editor.action.goToReferences"]
    },
    {
      "before": ["<leader>", "g", "i"],
      "commands": ["editor.action.goToImplementation"]
    },

    // Debug
    {
      "before": ["<leader>", "d", "a"],
      "commands": ["workbench.action.debug.selectandstart"]
    },
    {
      "before": ["<leader>", "d", "t"],
      "commands": ["workbench.action.debug.stop"]
    },
    {
      "before": ["<leader>", "d", "o"],
      "commands": ["workbench.action.debug.stepOver"]
    },
    {
      "before": ["<leader>", "d", "b"],
      "commands": ["editor.debug.action.toggleBreakpoint"]
    },
    {
      "before": ["<leader>", "d", "e"],
      "commands": ["editor.debug.action.showDebugHover"]
    },
    {
      "before": ["<leader>", "d", "c"],
      "commands": ["workbench.action.debug.continue"]
    },

    // Pseudo Telescope
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "f", "s"],
      "commands": ["workbench.action.findInFiles"]
    },
    {
      "before": ["<leader>", "f", "b"],
      "commands": ["workbench.action.showAllEditors"]
    },

    // Increment/decrement numbers
    { "before": ["<leader>", "+"], "after": ["<C-a>"] },
    { "before": ["<leader>", "-"], "after": ["<C-x>"] },

    // Toggle file explorer
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.files.action.focusFilesExplorer"]
    },

    // Close editor / close group
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "W"],
      "commands": ["workbench.action.closeEditorsInGroup"]
    },

    // Toggle zen mode
    {
      "before": ["<leader>", "z"],
      "commands": ["workbench.action.toggleZenMode"]
    },

    // Toggle monocle mode
    {
      "before": ["<leader>", "m"],
      "commands": ["workbench.action.toggleMaximizeEditorGroup"]
    }
  ],

  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["n"], "after": ["h"] }, // Left
    { "before": ["e"], "after": ["j"] }, // Down
    { "before": ["i"], "after": ["k"] }, // Up
    { "before": ["o"], "after": ["l"] }, // Right

    { "before": ["l"], "after": ["i"] }, // Inner text object
    { "before": ["h"], "after": ["o"] }, // Other end of selection
    { "before": ["j"], "after": ["e"] }, // End of word
    { "before": ["k"], "after": ["n"] }, // Next match

    { "before": ["N"], "after": ["H"] }, // Top of screen
    { "before": ["E"], "commands": ["editor.action.moveLinesDownAction"] }, // NOT J
    { "before": ["I"], "commands": ["editor.action.moveLinesUpAction"] }, // NOT K
    { "before": ["O"], "after": ["L"] }, // Bottom of screen

    { "before": ["L"], "after": ["I"] }, // Blockwise insert
    { "before": ["H"], "after": ["O"] }, // Other corner of block
    { "before": ["J"], "after": ["E"] }, // End of WORD
    { "before": ["K"], "after": ["N"] }, // Previous match

    // Coding
    {
      "before": ["<leader>", "c", "c"],
      "commands": ["editor.action.blockComment"]
    },

    // Keep the selection after indent/outdent
    { "before": ["<"], "after": ["<", "g", "v"] },
    { "before": [">"], "after": [">", "g", "v"] }
  ],

  "vim.operatorPendingModeKeyBindingsNonRecursive": [
    // Motions only — h/H (open line) and E/I have no meaning here

    { "before": ["n"], "after": ["h"] }, // Left
    { "before": ["e"], "after": ["j"] }, // Down
    { "before": ["i"], "after": ["k"] }, // Up
    { "before": ["o"], "after": ["l"] }, // Right

    { "before": ["l"], "after": ["i"] }, // Inner text object
    { "before": ["j"], "after": ["e"] }, // End of word
    { "before": ["k"], "after": ["n"] }, // Next match

    { "before": ["N"], "after": ["H"] }, // Top of screen
    { "before": ["O"], "after": ["L"] }, // Bottom of screen
    { "before": ["L"], "after": ["I"] }, // Around/inner variant
    { "before": ["J"], "after": ["E"] }, // End of WORD
    { "before": ["K"], "after": ["N"] } // Previous match
  ],

  /* -------------------------------- PRETTIER -------------------------------- */

  "prettier.configPath": "/home/brandon/.config/prettierrc.json",
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[less]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[mdx]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[vue]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[svelte]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[astro]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  /* ------------------------------- GIT BLAME -------------------------------- */

  "gitblame.inlineMessageEnabled": true,

  /* -------------------------------------------------------------------------- */
  /*                                     AI                                     */
  /* -------------------------------------------------------------------------- */

  // "github.copilot.enable": {
  //   "*": false
  // },
  "chat.viewSessions.enabled": false,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "When generating commit messages, use exactly: <type>(<scope>): <short_summary>."
    },
    {
      "text": "Allowed types: feat, fix, docs, style, perf, test, build, chore, revert."
    },
    {
      "text": "Allowed scopes: api, service, core, config, db, auth, ui, test, docs, lint, deps, build, ci, release."
    },
    {
      "text": "Rules: one title line always required; use imperative mood; keep short_summary concise (about 72 chars max); no trailing period; add body only when needed."
    }
  ],

  /* -------------------------------------------------------------------------- */
  /*                         LANGUAGE-SPECIFIC SETTINGS                         */
  /* -------------------------------------------------------------------------- */

  "files.associations": {
    "*.yml": "yaml"
  },
  "[latex]": {
    "editor.wordWrap": "on"
  },
  "[markdown][latex]": {
    "editor.rulers": [],
    "editor.tabSize": 4
  }
}
