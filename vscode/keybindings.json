/*
  Motion keys follow the permutation defined in settings.json:

      n e i o -> h j k l  (left / down / up / right)
      h j k l -> o e n i  (open line / end of word / search / insert)

  The same eight letters are reused in the file explorer and for the
  ctrl+alt / ctrl+shift / alt directional families below
*/

[
  /* -------------------------------------------------------------------------- */
  /*                                  ADDITIONS                                 */
  /* -------------------------------------------------------------------------- */

  {
    "key": "ctrl+s",
    "command": "workbench.action.showCommands"
  },
  {
    "key": "ctrl+r",
    "command": "workbench.action.togglePanel"
  },

  /* ------------------------------- SUGGESTIONS ------------------------------ */

  // Tab cycles instead of accepting. Enter still accepts, via the default
  // acceptSelectedSuggestion binding (see editor.acceptSuggestionOnEnter)
  {
    "key": "tab",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
  },
  {
    "key": "shift+tab",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
  },

  /* ----------------- FILE EXPLORER OPERATIONS AND NAVIGATION ---------------- */

  {
    "key": "i",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "e",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "n",
    "command": "list.collapse",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "o",
    "command": "list.expand",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "v",
    "command": "explorer.openToSide",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly"
  },
  {
    "key": "h",
    "command": "runCommands",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly",
    "args": {
      "commands": [
        "workbench.action.splitEditorDown",
        "explorer.openAndPassFocus",
        "workbench.action.closeOtherEditors"
      ]
    }
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly"
  },
  {
    // No readonly guard: copying a readonly file is legitimate
    "key": "c",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot"
  },
  {
    "key": "d",
    "command": "deleteFile",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly"
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly"
  },
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly"
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly"
  },
  {
    "key": "shift+a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly"
  },

  /* ---------------------- GROUPS AND EDITORS MANAGEMENT --------------------- */

  {
    "key": "tab",
    "command": "workbench.action.nextEditorInGroup",
    "when": "(vim.mode == 'Normal' || vim.mode == 'Visual') && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "shift+tab",
    "command": "workbench.action.previousEditorInGroup",
    "when": "(vim.mode == 'Normal' || vim.mode == 'Visual') && (editorTextFocus || !inputFocus)"
  },

  /* ------------------------------- MOVE GROUP ------------------------------- */

  {
    "key": "ctrl+shift+i",
    "command": "workbench.action.moveActiveEditorGroupUp"
  },
  {
    "key": "ctrl+shift+o",
    "command": "workbench.action.moveActiveEditorGroupRight"
  },
  {
    "key": "ctrl+shift+e",
    "command": "workbench.action.moveActiveEditorGroupDown"
  },
  {
    "key": "ctrl+shift+n",
    "command": "workbench.action.moveActiveEditorGroupLeft"
  },

  /* ------------------------------ RESIZE GROUP ------------------------------ */

  {
    "key": "alt+i",
    "command": "workbench.action.decreaseViewHeight"
  },
  {
    "key": "alt+o",
    "command": "workbench.action.increaseViewWidth"
  },
  {
    "key": "alt+e",
    "command": "workbench.action.increaseViewHeight"
  },
  {
    "key": "alt+n",
    "command": "workbench.action.decreaseViewWidth"
  },

  /* ------------------------------- NAVIGATION ------------------------------- */

  {
    "key": "ctrl+alt+i",
    "command": "workbench.action.navigateUp"
  },
  {
    "key": "ctrl+alt+o",
    "command": "workbench.action.navigateRight"
  },
  {
    "key": "ctrl+alt+e",
    "command": "workbench.action.navigateDown"
  },
  {
    "key": "ctrl+alt+n",
    "command": "workbench.action.navigateLeft"
  },

  /* -------------------------------- TERMINAL -------------------------------- */

  // The ctrl+t chord shadows the default ctrl+t (Go to Symbol in Workspace)
  // That command is still reachable via <leader>cas
  {
    "key": "ctrl+t f",
    "command": "workbench.action.terminal.focusFind",
    "when": "terminalFindFocused && terminalHasBeenCreated || terminalFindFocused && terminalProcessSupported || terminalFocusInAny && terminalHasBeenCreated || terminalFocusInAny && terminalProcessSupported"
  },
  {
    "key": "ctrl+t o",
    "command": "workbench.action.terminal.scrollToNextCommand",
    "when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled"
  },
  {
    "key": "ctrl+t n",
    "command": "workbench.action.terminal.scrollToPreviousCommand",
    "when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled"
  },
  {
    "key": "ctrl+up",
    "command": "workbench.action.terminal.scrollUpPage",
    "when": "terminalFocusInAny && terminalHasBeenCreated && !terminalAltBufferActive || terminalFocusInAny && terminalProcessSupported && !terminalAltBufferActive"
  },
  {
    "key": "ctrl+down",
    "command": "workbench.action.terminal.scrollDownPage",
    "when": "terminalFocusInAny && terminalHasBeenCreated && !terminalAltBufferActive || terminalFocusInAny && terminalProcessSupported && !terminalAltBufferActive"
  },

  /* -------------------------------------------------------------------------- */
  /*                                  DELETIONS                                 */
  /* -------------------------------------------------------------------------- */

  // NOTE: there is deliberately no save binding. files.autoSave is set to
  // "onFocusChange", and formatOnSave DOES run for that trigger (unlike
  // "afterDelay"), so formatting still happens. :w also works

  {
    "key": "ctrl+s",
    "command": "-workbench.action.files.save"
  },
  {
    "key": "ctrl+o",
    "command": "-workbench.action.files.openFile"
  },
  {
    "key": "ctrl+o",
    "command": "-workbench.action.files.openFileFolder"
  },
  {
    "key": "ctrl+n",
    "command": "-workbench.action.files.newUntitledFile"
  },
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+j",
    "command": "-workbench.action.togglePanel"
  },

  /* -------------------------------- TERMINAL -------------------------------- */

  {
    "key": "ctrl+f",
    "command": "-workbench.action.terminal.focusFind",
    "when": "terminalFindFocused && terminalHasBeenCreated || terminalFindFocused && terminalProcessSupported || terminalFocusInAny && terminalHasBeenCreated || terminalFocusInAny && terminalProcessSupported"
  },
  {
    "key": "ctrl+c",
    "command": "-workbench.action.terminal.copyAndClearSelection",
    "when": "terminalTextSelectedInFocused || terminalFocus && terminalHasBeenCreated && terminalTextSelected || terminalFocus && terminalProcessSupported && terminalTextSelected || terminalFocus && terminalTextSelected && terminalTextSelectedInFocused || terminalHasBeenCreated && terminalTextSelected && terminalTextSelectedInFocused || terminalProcessSupported && terminalTextSelected && terminalTextSelectedInFocused"
  },
  {
    "key": "ctrl+v",
    "command": "-workbench.action.terminal.paste",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  }
]
